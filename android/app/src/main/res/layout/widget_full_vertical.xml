<?xml version="1.0" encoding="utf-8"?>
<!-- Full vertical (3×3): the two dates and the place, then the six times as
     a list, the next on a light pill. Also the picker's preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/message"
        style="@style/WidgetText.Message" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/date"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_date"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hijri"
            style="@style/WidgetText.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_hijri"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/place"
                style="@style/WidgetText.Quiet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sample_place"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/calculated"
                style="@style/WidgetText.Calculated" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_panel"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout android:id="@+id/cell0" style="@style/WidgetRow">
                <TextView android:id="@+id/name0" style="@style/WidgetText.RowName" android:text="@string/sample_fajr" />
                <TextView android:id="@+id/time0" style="@style/WidgetText.RowTime" android:text="@string/sample_time0" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cell1" style="@style/WidgetRow">
                <TextView android:id="@+id/name1" style="@style/WidgetText.RowName" android:text="@string/sample_sunrise" />
                <TextView android:id="@+id/time1" style="@style/WidgetText.RowTime" android:text="@string/sample_time1" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cell2" style="@style/WidgetRow">
                <TextView android:id="@+id/name2" style="@style/WidgetText.RowName" android:text="@string/sample_dhuhr" />
                <TextView android:id="@+id/time2" style="@style/WidgetText.RowTime" android:text="@string/sample_time2" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cell3" style="@style/WidgetRow" android:background="@drawable/widget_pill">
                <TextView android:id="@+id/name3" style="@style/WidgetText.RowName" android:text="@string/sample_asr" android:textColor="@color/widget_on_pill" />
                <TextView android:id="@+id/time3" style="@style/WidgetText.RowTime" android:text="@string/sample_time3" android:textColor="@color/widget_on_pill" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cell4" style="@style/WidgetRow">
                <TextView android:id="@+id/name4" style="@style/WidgetText.RowName" android:text="@string/sample_maghrib" />
                <TextView android:id="@+id/time4" style="@style/WidgetText.RowTime" android:text="@string/sample_time4" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cell5" style="@style/WidgetRow">
                <TextView android:id="@+id/name5" style="@style/WidgetText.RowName" android:text="@string/sample_isha" />
                <TextView android:id="@+id/time5" style="@style/WidgetText.RowTime" android:text="@string/sample_time5" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
