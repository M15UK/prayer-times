<?xml version="1.0" encoding="utf-8"?>
<!-- The larger widget: the place and a countdown, today's six times in two
     columns (the next one highlighted), and where the times came from.
     It shows the message until the app has saved some times. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <TextView
        android:id="@+id/message"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:maxLines="3"
        android:text="@string/widget_open_app"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/place"
                style="@style/WidgetText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/countdown"
                style="@style/WidgetText.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/row0" style="@style/WidgetRow">
                    <TextView android:id="@+id/name0" style="@style/WidgetText.RowName" />
                    <TextView android:id="@+id/time0" style="@style/WidgetText.RowTime" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row1" style="@style/WidgetRow">
                    <TextView android:id="@+id/name1" style="@style/WidgetText.RowName" />
                    <TextView android:id="@+id/time1" style="@style/WidgetText.RowTime" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row2" style="@style/WidgetRow">
                    <TextView android:id="@+id/name2" style="@style/WidgetText.RowName" />
                    <TextView android:id="@+id/time2" style="@style/WidgetText.RowTime" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/row3" style="@style/WidgetRow">
                    <TextView android:id="@+id/name3" style="@style/WidgetText.RowName" />
                    <TextView android:id="@+id/time3" style="@style/WidgetText.RowTime" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row4" style="@style/WidgetRow">
                    <TextView android:id="@+id/name4" style="@style/WidgetText.RowName" />
                    <TextView android:id="@+id/time4" style="@style/WidgetText.RowTime" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row5" style="@style/WidgetRow">
                    <TextView android:id="@+id/name5" style="@style/WidgetText.RowName" />
                    <TextView android:id="@+id/time5" style="@style/WidgetText.RowTime" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/source"
            style="@style/WidgetText.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
