<?xml version="1.0" encoding="utf-8"?>
<!-- Digital clock (3×2): big live hours and minutes, the two dates, and the
     next prayer with its countdown. The clocks keep themselves up to date
     and follow the phone's 12/24-hour setting. Also the picker's preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <TextView
        android:id="@+id/message"
        style="@style/WidgetText.Message" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                style="@style/WidgetText"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:background="@drawable/widget_clock_square"
                android:format12Hour="h"
                android:format24Hour="HH"
                android:gravity="center"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextClock
                style="@style/WidgetText"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_clock_square"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:gravity="center"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/ampm"
                style="@style/WidgetText.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/date"
                style="@style/WidgetText.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_date"
                android:textAllCaps="true"
                android:textSize="12sp" />

            <TextView
                style="@style/WidgetText.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_dot"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hijri"
                style="@style/WidgetText.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_hijri"
                android:textAllCaps="true"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- First, so the countdown is cut before the mark ever is. -->
            <TextView
                android:id="@+id/calculated"
                style="@style/WidgetText.Calculated"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/next_name"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_asr"
                android:textAllCaps="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/next_time"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/sample_time3"
                android:textSize="12sp" />

            <Chronometer
                android:id="@+id/countdown"
                style="@style/WidgetText.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:format="@string/sample_countdown_clock"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
