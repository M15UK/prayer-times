<?xml version="1.0" encoding="utf-8"?>
<!-- Mini (2×1). It starts with the loading message; the picker's preview is
     its own layout with sample text. The 30-minute update is a safety net:
     the widget's alarm redraws it at each prayer and at midnight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:previewLayout="@layout/widget_mini"
    android:resizeMode="horizontal"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
