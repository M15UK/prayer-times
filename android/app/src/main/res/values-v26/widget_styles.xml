<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ only: the column text shrinks to fit rather than being cut.
     Replaces the two styles of the same names in values/widget_styles.xml. -->
<resources>
    <style name="WidgetText.ColumnName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">12sp</item>
    </style>

    <style name="WidgetText.ColumnTime">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
    </style>
</resources>
